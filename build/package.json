{
  "name": "eem305simlab-build",
  "version": "1.0.0",
  "private": true,
  "description": "Build tooling for EEM305SimLab (bundles libraries into a single HTML file)",
  "scripts": {
    "bundle-cm": "esbuild cmEntry.js --bundle --minify --format=iife --global-name=CM --outfile=cm.min.js",
    "build": "npm run bundle-cm && python3 build.py"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "chart.js": "^4.6.1",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.1",
    "lucide-static": "^1.70.0"
  }
}